{
  "transactions": {
    "slowThresholdMillis": 2000,
    "profilingIntervalMillis": 1000,
    "captureThreadStats": true
  },
  "jvm": {
    "maskSystemProperties": [
      "*password*",
      "*token*",
      "*access*",
      "*secret*"
    ],
    "maskMBeanAttributes": [
      "*password*",
      "*token*",
      "*access*",
      "*secret*"
    ]
  },
  "uiDefaults": {
    "defaultTransactionType": "Web",
    "defaultPercentiles": [
      50.0,
      95.0,
      99.0
    ],
    "defaultGaugeNames": [
      "java.lang:type=Memory:HeapMemoryUsage.used"
    ]
  },
  "advanced": {
    "immediatePartialStoreThresholdSeconds": 60,
    "maxTransactionAggregates": 500,
    "maxQueryAggregates": 500,
    "maxServiceCallAggregates": 500,
    "maxTraceEntriesPerTransaction": 2000,
    "maxProfileSamplesPerTransaction": 50000,
    "mbeanGaugeNotFoundDelaySeconds": 60
  },
  "gauges": [
    {
      "mbeanObjectName": "java.lang:type=Memory",
      "mbeanAttributes": [
        {
          "name": "HeapMemoryUsage.used"
        }
      ]
    },
    {
      "mbeanObjectName": "java.lang:type=GarbageCollector,name=*",
      "mbeanAttributes": [
        {
          "name": "CollectionCount",
          "counter": true
        },
        {
          "name": "CollectionTime",
          "counter": true
        }
      ]
    },
    {
      "mbeanObjectName": "java.lang:type=MemoryPool,name=*",
      "mbeanAttributes": [
        {
          "name": "Usage.used"
        }
      ]
    },
    {
      "mbeanObjectName": "java.lang:type=OperatingSystem",
      "mbeanAttributes": [
        {
          "name": "FreePhysicalMemorySize"
        },
        {
          "name": "ProcessCpuLoad"
        },
        {
          "name": "SystemCpuLoad"
        }
      ]
    }
  ],
  "plugins": [
    {
      "properties": {
        "stackTraceThresholdMillis": 1000.0
      },
      "id": "cassandra"
    },
    {
      "properties": {
        "stackTraceThresholdMillis": 1000.0
      },
      "id": "elasticsearch"
    },
    {
      "properties": {
        "sessionUserAttribute": "",
        "captureSessionAttributes": [ ],
        "captureRequestParameters": [
          "*"
        ],
        "maskRequestParameters": [
          "*password*",
          "*token*",
          "*access*",
          "*secret*"
        ],
        "captureRequestHeaders": [ ],
        "captureResponseHeaders": [ ],
        "traceErrorOn4xxResponseCode": false,
        "captureRequestRemoteAddr": false,
        "captureRequestRemoteHostname": false,
        "captureRequestRemotePort": false,
        "captureRequestLocalAddr": false,
        "captureRequestLocalHostname": false,
        "captureRequestLocalPort": false,
        "captureRequestServerHostname": false,
        "captureRequestServerPort": false
      },
      "id": "jakartaservlet"
    },
    {
      "properties": {
        "captureRequestHeaders": [
          "*"
        ],
        "maskRequestHeaders": [
          "Authorization",
          "*"
        ],
        "captureRequestRemoteAddr": false,
        "captureRequestRemoteHost": false,
        "captureResponseHeaders": [ ],
        "traceErrorOn4xxResponseCode": true
      },
      "id": "java-http-server"
    },
    {
      "properties": {
        "useAltTransactionNaming": false
      },
      "id": "jaxrs"
    },
    {
      "properties": {
        "captureBindParametersIncludes": [
          ".*"
        ],
        "captureBindParametersExcludes": [ ],
        "captureResultSetNavigate": true,
        "captureResultSetGet": true,
        "captureConnectionPoolLeaks": true,
        "captureConnectionPoolLeakDetails": false,
        "captureGetConnection": true,
        "captureConnectionClose": true,
        "capturePreparedStatementCreation": true,
        "captureStatementClose": true,
        "captureTransactionLifecycleTraceEntries": true,
        "captureConnectionLifecycleTraceEntries": true,
        "stackTraceThresholdMillis": 1000.0
      },
      "id": "jdbc"
    },
    {
      "properties": {
        "traceErrorOnErrorWithThrowable": true,
        "traceErrorOnErrorWithoutThrowable": false,
        "traceErrorOnWarningWithThrowable": false,
        "traceErrorOnWarningWithoutThrowable": false
      },
      "id": "logger"
    },
    {
      "properties": {
        "stackTraceThresholdMillis": 1000.0
      },
      "id": "mongodb"
    },
    {
      "properties": {
        "useAltTransactionNaming": false
      },
      "id": "play"
    },
    {
      "properties": {
        "sessionUserAttribute": "",
        "captureSessionAttributes": [ ],
        "captureRequestParameters": [
          "*"
        ],
        "maskRequestParameters": [
          "*password*",
          "*token*",
          "*access*",
          "*secret*"
        ],
        "captureRequestHeaders": [ ],
        "captureResponseHeaders": [ ],
        "traceErrorOn4xxResponseCode": false,
        "captureRequestRemoteAddr": false,
        "captureRequestRemoteHostname": false,
        "captureRequestRemotePort": false,
        "captureRequestLocalAddr": false,
        "captureRequestLocalHostname": false,
        "captureRequestLocalPort": false,
        "captureRequestServerHostname": false,
        "captureRequestServerPort": false
      },
      "id": "servlet"
    },
    {
      "properties": {
        "useAltTransactionNaming": false
      },
      "id": "spring"
    }
  ],
  "instrumentation": [
    {
      "className": "dev.rafex.ether.glowroot.jetty12.GlowrootJettyHandler",
      "methodName": "handle",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "transaction",
      "transactionType": "Web",
      "transactionNameTemplate": "{{0.method}} {{0.httpURI.path}}",
      "alreadyInTransactionBehavior": "capture-trace-entry",
      "traceEntryMessageTemplate": "{{0.method}} {{0.httpURI.path}}",
      "timerName": "jetty handler"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "search",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.search",
      "timerName": "ObjectService: search"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "fuzzy",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.fuzzy",
      "timerName": "ObjectService: fuzzy"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "getById",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.getById",
      "timerName": "ObjectService: getById"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "create",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.create",
      "timerName": "ObjectService: create"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "move",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.move",
      "timerName": "ObjectService: move"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "updateTags",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.updateTags",
      "timerName": "ObjectService: updateTags"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.ObjectServiceImpl",
      "methodName": "updateText",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.updateText",
      "timerName": "ObjectService: updateText"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.AuthServiceImpl",
      "methodName": "authenticate",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.authenticate",
      "timerName": "AuthService: authenticate"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.AppClientAuthServiceImpl",
      "methodName": "authenticate",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.authenticate",
      "timerName": "AppClientAuthService: authenticate"
    },
    {
      "className": "dev.rafex.kiwi.services.impl.LocationServiceImpl",
      "methodName": "create",
      "methodParameterTypes": [
        ".."
      ],
      "order": 0,
      "captureKind": "trace-entry",
      "traceEntryMessageTemplate": "{{this.class.simpleName}}.create",
      "timerName": "LocationService: create"
    }
  ]
}
